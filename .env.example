# Copie para .env e ajuste. NUNCA versione o arquivo .env.
DATABASE_URL=postgresql://localhost:5432/setflow
PORT=3000
NODE_ENV=development
# Base dos links de redefinição de senha enviados por e-mail
APP_BASE_URL=http://localhost:3000
# Cookie de sessão Secure: padrão = só em NODE_ENV=production. Em HTTP (sem HTTPS) fora de
# localhost, como no celular pela rede local, use false.
# COOKIE_SECURE=false
