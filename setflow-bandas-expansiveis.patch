--- a/public/styles.css	2026-11-20 00:41:20.003623921 +0000
+++ b/public/styles.css	2026-11-20 00:47:03.497510856 +0000
@@ -19,6 +19,14 @@
 .auth-links { text-align: center; margin: 6px 0 0; }
 .link-button { background: transparent; color: var(--primary-dark); font-size: 14px; font-weight: 700; padding: 10px 6px; text-decoration: underline; }
 #auth-info:not(:empty) { margin: 0 0 12px; }
+.band-item { padding: 0; }
+.band-item .band-card { padding: 16px; background: transparent; border-radius: 18px; }
+.band-meta { display: flex; align-items: center; gap: 10px; }
+.chevron { font-size: 22px; color: var(--muted); transition: transform .15s ease; }
+.band-item.open .chevron { transform: rotate(90deg); }
+.band-members { display: grid; gap: 12px; padding: 12px 16px 16px; border-top: 1px solid var(--line); }
+.member-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
+.member-list li { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-weight: 600; overflow-wrap: anywhere; }
 .file-link { color: var(--primary-dark); font-weight: 600; text-decoration: none; word-break: break-all; }
